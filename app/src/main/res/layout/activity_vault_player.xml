<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E"
    android:fitsSystemWindows="true">

    <!-- Main Unlocked Vault Content -->
    <LinearLayout
        android:id="@+id/vaultMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <LinearLayout
            android:id="@+id/vaultTopBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1E1E2E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btnVaultBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:text="←"
                android:textColor="#CDD6F4"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:text="Private Vault"
                android:textColor="#CDD6F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAutoNext"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="#313244"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="Auto: ON"
                android:textAllCaps="false"
                android:textColor="#A6E3A1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnLockVault"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="🔒"
                android:textColor="#CBA6F7"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Embedded Video Player Container -->
        <LinearLayout
            android:id="@+id/playerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/playerFrame"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#11111B">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/vaultPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:show_buffering="when_playing"
                    app:use_controller="true" />
            </FrameLayout>

            <!-- Quick Video Switcher Bar (No Need to Close Video) -->
            <LinearLayout
                android:id="@+id/quickSwitchBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#181825"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <Button
                    android:id="@+id/btnPrevVideo"
                    android:layout_width="44dp"
                    android:layout_height="34dp"
                    android:background="#313244"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="⏮"
                    android:textColor="#CDD6F4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvNowPlaying"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:text="Select a video"
                    android:textColor="#CDD6F4"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNextVideo"
                    android:layout_width="44dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="#313244"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="⏭"
                    android:textColor="#CDD6F4"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnPlaylistPopup"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="#313244"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="☰ List"
                    android:textAllCaps="false"
                    android:textColor="#CBA6F7"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFullscreen"
                    android:layout_width="38dp"
                    android:layout_height="34dp"
                    android:background="#313244"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="⛶"
                    android:textColor="#CDD6F4"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Videos / Downloading Tabs -->
        <LinearLayout
            android:id="@+id/vaultTabsBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1E1E2E"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabVideos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Videos"
                    android:textColor="#CBA6F7"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indTabVideos"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="#CBA6F7" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabDownloading"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabDownloading"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Downloading"
                    android:textColor="#6C7086"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/indTabDownloading"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyVault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="40dp"
            android:text="No videos in vault yet"
            android:textColor="#6C7086"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Live Vault Videos / Downloads List -->
        <ListView
            android:id="@+id/vaultListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:padding="14dp" />
    </LinearLayout>

    <!-- Catppuccin Mocha PIN Lock Screen Overlay -->
    <LinearLayout
        android:id="@+id/pinLockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E1E2E"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="🔒"
            android:textColor="#CBA6F7"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/tvPinHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Vault Locked"
            android:textColor="#CDD6F4"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/pinDotsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/pinDot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp" />

            <View
                android:id="@+id/pinDot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp" />

            <View
                android:id="@+id/pinDot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp" />

            <View
                android:id="@+id/pinDot4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/pinKeypadGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4" />

        <Button
            android:id="@+id/btnPinUnlock"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="#CBA6F7"
            android:text="Unlock"
            android:textAllCaps="false"
            android:textColor="#11111B"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
