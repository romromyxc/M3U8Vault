<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06070D">

    <!-- Video Player Container -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <!-- Gesture Touch Zone (Double-tap left/right to seek, swipe up/down for volume/brightness) -->
        <View
            android:id="@+id/gestureOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="54dp" />

        <!-- Center Neon HUD Pill -->
        <TextView
            android:id="@+id/tvGestureHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_hud_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Top-Right Neon Rotate & Fullscreen Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_btn_neon_dark"
                app:backgroundTint="@null"
                android:text="⟳"
                android:textColor="#00E5FF"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_btn_neon_pink"
                app:backgroundTint="@null"
                android:text="⛶"
                android:textColor="#FF6EB4"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Neon Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#FF2A85" />

    <!-- Vault List Section -->
    <LinearLayout
        android:id="@+id/vaultListSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#06070D">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B0E1A"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:text="⚡ TOKYO VAULT  •  Tap to Play  •  Long-Press to Delete"
            android:textColor="#BB9AF7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/downloadListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#06070D"
            android:dividerHeight="8dp"
            android:padding="10dp" />
    </LinearLayout>
</LinearLayout>
<!-- END OF FILE -->
