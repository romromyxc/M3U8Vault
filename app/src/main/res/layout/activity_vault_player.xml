<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Video Player Container -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <!-- Gesture Touch Zone (Leaves top-right buttons & bottom scrubber clickable) -->
        <View
            android:id="@+id/gestureOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="46dp"
            android:layout_marginBottom="54dp" />

        <!-- Center Floating Feedback Pill (Seek +10s/-10s, Volume %, Brightness %) -->
        <TextView
            android:id="@+id/tvGestureHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC111111"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Top-Right Compact Rotate & Fullscreen Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#88000000"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="#33FFFFFF"
                android:text="⟳"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="#33FFFFFF"
                android:text="⛶"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Vault List Section -->
    <LinearLayout
        android:id="@+id/vaultListSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#000000">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121212"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Downloads &amp; Vault (Tap to Play • Long-Press to Delete)"
            android:textColor="#B0B0B0"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/downloadListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#000000"
            android:dividerHeight="6dp"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
<!-- END OF FILE -->
