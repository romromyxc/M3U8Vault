<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E"
    android:fitsSystemWindows="true">

    <!-- Unified Single-Section Vault Content -->
    <LinearLayout
        android:id="@+id/vaultMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <LinearLayout
            android:id="@+id/vaultTopBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1E1E2E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btnVaultBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="←"
                android:textColor="#CDD6F4"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:text="⚡ Vault"
                android:textColor="#CDD6F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAutoNext"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="#313244"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Auto: ON"
                android:textAllCaps="false"
                android:textColor="#A6E3A1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnLockVault"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="🔓"
                android:textColor="#CBA6F7"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Embedded Video Player Container -->
        <LinearLayout
            android:id="@+id/playerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/playerFrame"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#11111B">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/vaultPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:show_buffering="when_playing"
                    app:use_controller="true" />
            </FrameLayout>

            <!-- Clean Player Bar (Swipe Up/Down on Video for Next/Prev) -->
            <LinearLayout
                android:id="@+id/quickSwitchBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#181825"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvNowPlaying"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingEnd="10dp"
                    android:text="Select a video"
                    android:textColor="#CDD6F4"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlaylistPopup"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="#313244"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="☰ List"
                    android:textAllCaps="false"
                    android:textColor="#CBA6F7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFullscreen"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:background="#313244"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="⛶"
                    android:textColor="#CDD6F4"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyVault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="40dp"
            android:text="No videos in vault yet"
            android:textColor="#6C7086"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Unified List: Active Downloads (when running) + Saved Videos -->
        <ListView
            android:id="@+id/vaultListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:padding="14dp" />
    </LinearLayout>

    <!-- Scrollable Catppuccin Mocha Optional PIN Lock Overlay -->
    <ScrollView
        android:id="@+id/pinLockScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E1E2E"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pinLockOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🔒"
                android:textColor="#CBA6F7"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvPinHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Vault Locked"
                android:textColor="#CDD6F4"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pinDotsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pinDot1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="8dp" />

                <View
                    android:id="@+id/pinDot2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="8dp" />

                <View
                    android:id="@+id/pinDot3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="8dp" />

                <View
                    android:id="@+id/pinDot4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="8dp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/pinKeypadGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4" />

            <Button
                android:id="@+id/btnPinUnlock"
                android:layout_width="210dp"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="#CBA6F7"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Unlock"
                android:textAllCaps="false"
                android:textColor="#11111B"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
