<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Minimalist Top Search Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E2E"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/searchPillContainer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#313244"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search or enter URL"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="#CDD6F4"
                android:textColorHint="#6C7086"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnReload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="↻"
                android:textColor="#CDD6F4"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thin Mauve Loading Progress Line -->
    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressBackgroundTint="#1E1E2E"
        android:progressTint="#CBA6F7"
        android:visibility="gone" />

    <!-- Browser Canvas + Floating Pop-up & Stream Pills -->
    <FrameLayout
        android:id="@+id/canvasWrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Ad-Free Pop-up Video Player Pill (UC / Coc Coc Style) -->
        <Button
            android:id="@+id/btnPopupPlayer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="64dp"
            android:background="#CBA6F7"
            android:elevation="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:text="▶ Pop-up"
            android:textAllCaps="false"
            android:textColor="#11111B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Draggable Mint Stream Catcher Pill -->
        <Button
            android:id="@+id/btnFloatingCatcher"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="#A6E3A1"
            android:elevation="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:text="⬇ 1"
            android:textAllCaps="false"
            android:textColor="#11111B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Ultra-Clean 3-Icon Bottom Dock (Tabs | Lightning Vault | Settings) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1E1E2E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Left: Tab Counter -->
        <FrameLayout
            android:id="@+id/tabSlot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btnTabs"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Center: Lightning Private Vault -->
        <Button
            android:id="@+id/btnVault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚡"
            android:textColor="#CBA6F7"
            android:textSize="22sp" />

        <!-- Right: Settings Gear -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚙"
            android:textColor="#CDD6F4"
            android:textSize="21sp" />
    </LinearLayout>

</LinearLayout>
