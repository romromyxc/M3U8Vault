<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Bar with Unified Search Pill & 2-in-1 Action Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#1E1E2E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp">

        <LinearLayout
            android:id="@+id/searchPillContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#313244"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search or enter URL"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="#CDD6F4"
                android:textColorHint="#6C7086"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnReload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Reload or Clear"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="↻"
                android:textColor="#CDD6F4"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Catppuccin Mauve Progress Hairline -->
    <ProgressBar
        android:id="@+id/pageProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressBackgroundTint="#181825"
        android:progressTint="#CBA6F7"
        android:visibility="gone" />

    <!-- Full-Height WebView Canvas + Auto-Hiding Floating Catcher -->
    <FrameLayout
        android:id="@+id/canvasWrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E2E">

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnFloatingCatcher"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="#A6E3A1"
            android:elevation="6dp"
            android:minWidth="68dp"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:text="⬇ 0"
            android:textAllCaps="false"
            android:textColor="#11111B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Subtle Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#181825" />

    <!-- Minimalist 5-Icon Bottom Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E1E2E"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="←"
            android:textColor="#45475A"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Forward"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="→"
            android:textColor="#45475A"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/tabSlot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Open Tabs"
            android:focusable="true">

            <TextView
                android:id="@+id/btnTabs"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textColor="#CDD6F4"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <Button
            android:id="@+id/btnVault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Private Vault &amp; Downloads"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="⚡"
            android:textColor="#CBA6F7"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Menu"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="⋮"
            android:textColor="#CDD6F4"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>
