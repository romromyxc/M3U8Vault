<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06070D">

    <!-- Clean Single Top Search & Address Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="7dp"
        android:background="#0A0D18">

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neon_input"
            android:hint="Search SearXNG or enter URL..."
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="#F0F4FF"
            android:textColorHint="#68749C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearUrl"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_btn_neon_dark"
            app:backgroundTint="@null"
            android:text="✕"
            android:textColor="#FF2A85"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_btn_neon_dark"
            app:backgroundTint="@null"
            android:text="↻"
            android:textColor="#00E5FF"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Neon Loading Line -->
    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_neon"
        android:visibility="gone" />

    <!-- WebView Viewport -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#06070D" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1D2542" />

    <!-- Single Minimal Bottom Bar: Back | Download | Tab Icon | Downloading | Hidden Nav Menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="7dp"
        android:background="#0A0D18">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_btn_neon_dark"
            app:backgroundTint="@null"
            android:enabled="false"
            android:text="◀"
            android:textColor="#E2E8FF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDownloadBadge"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_btn_neon_cyan"
            app:backgroundTint="@null"
            android:text="⬇ Download (0)"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Tab Icon Positioned Right in the Middle -->
        <Button
            android:id="@+id/btnTabs"
            android:layout_width="46dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="6dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_btn_neon_dark"
            app:backgroundTint="@null"
            android:text="❐ 1"
            android:textColor="#BB9AF7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVault"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_btn_neon_pink"
            app:backgroundTint="@null"
            android:text="⚡ Downloading"
            android:textColor="#FF6EB4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_btn_neon_dark"
            app:backgroundTint="@null"
            android:text="☰"
            android:textColor="#00FF9C"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
<!-- END OF FILE -->
